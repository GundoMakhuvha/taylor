# Copy to .env.local (local) or add in Vercel → Settings → Environment Variables.
# Anything WITHOUT the NEXT_PUBLIC_ prefix stays on the server and never reaches the browser.
# Never commit real keys to GitHub.

# ======================= App =======================
APP_URL=https://taylor.capvtal.com

# ======================= Brain =======================
# "anthropic" (smartest; recommended) or "groq" (fastest/cheapest). If unset, Taylor uses whichever key is present.
AI_PROVIDER=anthropic
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional for gpt-oss models: low | medium | high
GROQ_REASONING_EFFORT=
# Alternative engine
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Live web search. "off" disables it.
WEB_SEARCH=on
WEB_SEARCH_MAX_USES=3

# ======================= Voice =======================
# "fish", "azure" or "elevenlabs". If unset, Taylor uses the first one that's configured.
VOICE_PROVIDER=fish
FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=s2.1-pro
FISH_LATENCY=balanced
# Azure Speech (free tier)
SPEECH_KEY=
SPEECH_REGION=southafricanorth
SPEECH_VOICE=en-GB-SoniaNeural
# ElevenLabs
VOICE_API_KEY=
VOICE_ID=
VOICE_MODEL=eleven_multilingual_v2

# ======================= Accounts + history (Supabase) =======================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Shows "Continue with Google" on the sign-in screen (after enabling Google in Supabase).
NEXT_PUBLIC_GOOGLE_SIGNIN=on
# Only these emails may use Taylor (comma-separated). Strongly recommended.
ALLOWED_EMAILS=

# ======================= Connectors =======================
# Server-only Supabase key (Project Settings → API Keys → secret / service_role). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Encrypts stored account tokens. Generate once: openssl rand -base64 32   (don't change it later)
CONNECTIONS_SECRET=

# Google: Gmail + Calendar (also usable for "Continue with Google" in Supabase)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft: Outlook mail + calendar
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Meta: Facebook Page + Instagram (and the app that owns WhatsApp)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional: pin the API version (YYYYMM). Leave empty to auto-select.
LINKEDIN_VERSION=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ======================= WhatsApp Business (Cloud API) =======================
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string you choose; paste the same value into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Defaults to META_APP_SECRET if empty.
WHATSAPP_APP_SECRET=
# "on" = Taylor answers customers automatically.
WHATSAPP_AUTO_REPLY=on
# Who may send from / read the business number inside Taylor (defaults to ALLOWED_EMAILS).
WHATSAPP_OWNER_EMAILS=
WHATSAPP_DEFAULT_COUNTRY_CODE=27

# ======================= Running Capvtal (v4) =======================
# You, the owner. Must match the email you sign in to Taylor with.
OWNER_EMAIL=
OWNER_NAME=Gundo
OWNER_TIMEZONE=Africa/Johannesburg
# Your personal WhatsApp number (gets updates; messages from it go to the full Taylor)
OWNER_WHATSAPP=
# Where updates are emailed (defaults to OWNER_EMAIL)
OWNER_NOTIFY_EMAIL=
# Approved WhatsApp template for updates when the 24h window is closed (one {{1}} body variable)
WHATSAPP_UPDATE_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Resend: Taylor's automated emails to YOU (briefings, alerts, post previews). Not for cold email.
RESEND_API_KEY=
RESEND_FROM=Taylor <taylor@capvtal.com>

# Vercel Cron protection: any long random string
CRON_SECRET=

# Social autopilot. "off" = Taylor drafts daily and sends you an approve link. "on" = publishes automatically.
SOCIAL_AUTOPILOT=off
SOCIAL_DAILY=on
SOCIAL_PLATFORMS=facebook,instagram,tiktok

# Lead finder (Google Places API, New)
GOOGLE_PLACES_API_KEY=
LEAD_SEARCHES_PER_DAY=2
# Optional overrides, comma-separated
LEAD_CATEGORIES=
LEAD_AREAS=

# Laptop companion speech-to-text (uses GROQ_API_KEY)
GROQ_STT_MODEL=whisper-large-v3-turbo
